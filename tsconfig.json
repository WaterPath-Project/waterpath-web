{
    "compilerOptions": {
      "target": "esnext",
      "module": "esnext",
      "jsx": "react-jsx",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["external-repos/waterpath-data-integration-tool/*"]
      }
    },
    "include": ["src", "external-repos/waterpath-data-integration-tool"]
  }
  